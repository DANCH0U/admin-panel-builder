<?php

namespace App\AdminPanel\Pages\{{ panelStudly }};

use App\AdminPanel\Engine\BasePage;
use App\AdminPanel\Schema\Button;
use App\AdminPanel\Schema\Card;
use App\AdminPanel\Schema\Flex;
use App\AdminPanel\Schema\Heading;
use App\AdminPanel\Schema\KeyValue;
use App\AdminPanel\Schema\Space;
use App\AdminPanel\Schema\Text;
use App\Models\User;

class UserViewPage extends BasePage
{
    public function __construct(protected User $user) {}

    public function title(): ?string
    {
        return $this->user->name ?? 'User';
    }

    public function authorize(): bool
    {
        return true;
    }

    public function schema(): array
    {
        $record = $this->user;

        return [
            Flex::make()
                ->justify('between')
                ->align('end')
                ->wrap()
                ->gap(4)
                ->schema([
                    Flex::make()
                        ->direction('column')
                        ->align('start')
                        ->gap(1)
                        ->schema([
                            Heading::make($record->name ?? 'User')->level(1),
                            Text::make('View account details for this user.')
                                ->variant('subdued'),
                        ]),
                    Flex::make()->gap(2)->schema([
                        Button::make('Edit')
                            ->variant('outline')
                            ->url(admin_path('users/'.$record->getKey().'/edit')),
                        Button::make('Back')
                            ->variant('secondary')
                            ->url(admin_path('users')),
                    ]),
                ]),

            Space::make(6),

            Card::make()
                ->border()
                ->label('Details')
                ->helpText('Read-only snapshot of this user record.')
                ->schema([
                    KeyValue::make()->entries([
                        'ID' => $record->getKey(),
                        'Name' => $record->name ?? '—',
                        'Email' => $record->email ?? '—',
                        'Admin' => $record->is_admin ? 'Yes' : 'No',
                        'Default panel' => $record->default_panel ?: '—',
                        'Created' => $record->created_at?->format('M d, Y H:i') ?? '—',
                    ]),
                ]),
        ];
    }
}
