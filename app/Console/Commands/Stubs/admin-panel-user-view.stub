<?php

namespace App\AdminPanel\Pages\{{ panelStudly }};

use App\AdminPanel\Engine\BasePage;
use App\AdminPanel\Schema\Button;
use App\AdminPanel\Schema\Card;
use App\AdminPanel\Schema\Flex;
use App\AdminPanel\Schema\Heading;
use App\AdminPanel\Schema\Image;
use App\AdminPanel\Schema\KeyValue;
use App\AdminPanel\Schema\Space;
use App\AdminPanel\Schema\Text;

class UserViewPage extends BasePage
{
    /** @var object */
    protected object $data;

    public function __construct(array|object $data = [])
    {
        $this->data = is_array($data) ? (object) $data : $data;
    }

    public function title(): ?string
    {
        return $this->data->name ?? 'User';
    }

    public function schema(): array
    {
        $schema = [
            Flex::make()
                ->justify('between')
                ->align('end')
                ->wrap()
                ->gap(4)
                ->schema([
                    Flex::make()
                        ->direction('column')
                        ->align('start')
                        ->gap(1)
                        ->schema([
                            Heading::make($this->data->name ?? 'User')->level(1),
                            Text::make('View account details for this user.')
                                ->variant('subdued'),
                        ]),
                    Flex::make()->gap(2)->schema([
                        Button::make('Edit')
                            ->variant('outline')
                            ->url(admin_path('users/'.($this->data->id ?? '').'/edit')),
                        Button::make('Back')
                            ->variant('secondary')
                            ->url(admin_path('users')),
                    ]),
                ]),

            Space::make(6),

            Card::make()
                ->border()
                ->label('Details')
                ->helpText('Read-only snapshot of this user record.')
                ->schema([
                    KeyValue::make()->entries([
                        'ID' => $this->data->id ?? '—',
                        'Name' => $this->data->name ?? '—',
                        'Email' => $this->data->email ?? '—',
                        'Admin' => ! empty($this->data->is_admin) ? 'Yes' : 'No',
                        'Default panel' => $this->data->default_panel ?: '—',
                        'Created' => isset($this->data->created_at)
                            ? \Carbon\Carbon::parse($this->data->created_at)->format('M d, Y H:i')
                            : '—',
                    ]),
                ]),
        ];

        if (! empty($this->data->avatar)) {
            $schema[] = Space::make(4);
            $schema[] = Image::make($this->data->avatar)->label('Avatar');
        }

        return $schema;
    }
}
