<?php

namespace App\AdminPanel\Resources\{{ panelStudly }};

use App\AdminPanel\Engine\BaseResource;
use App\AdminPanel\Schema\Button;
use App\AdminPanel\Schema\Flex;
use App\AdminPanel\Schema\Heading;
use App\AdminPanel\Schema\Space;
use App\AdminPanel\Schema\Text;
use App\AdminPanel\Tables\Action;
use App\AdminPanel\Tables\BooleanColumn;
use App\AdminPanel\Tables\BulkAction;
use App\AdminPanel\Tables\Search;
use App\AdminPanel\Tables\SelectFilter;
use App\AdminPanel\Tables\TextColumn;
use App\Models\User;

class UserResource extends BaseResource
{
    protected string $key = 'users';

    protected string $model = User::class;


    public function title(): ?string
    {
        return 'Users';
    }

    public function header(): array
    {
        return [
            Flex::make()
                ->justify('between')
                ->align('end')
                ->wrap()
                ->gap(4)
                ->schema([
                    Flex::make()
                        ->direction('column')
                        ->align('start')
                        ->gap(1)
                        ->schema([
                            Heading::make('Users')->level(1),
                            Text::make('Create, edit, and manage panel users.')
                                ->variant('subdued'),
                        ]),
                    Flex::make()->gap(2)->schema([
                        Button::make('Add user')->url(admin_path('users/create')),
                    ]),
                ]),
            Space::make(4),
        ];
    }

    public function schema(): array
    {
        return [
            'search_placeholder' => 'Search users...',
            'search_columns' => [
                Search::column('name')->weight(3),
                Search::column('email')->weight(2),
            ],
            'columns' => [
                TextColumn::make('id')->label('ID')->sortable(),
                TextColumn::make('name')->label('Name')->sortable()->toggleable(),
                TextColumn::make('email')->label('Email')->sortable()->toggleable(),
                BooleanColumn::make('is_admin')->label('Admin'),
                TextColumn::make('default_panel')->label('Default panel')->toggleable(),
                TextColumn::make('created_at')
                    ->label('Created')
                    ->sortable()
                    ->transform(fn ($v) => $v ? \Carbon\Carbon::parse($v)->format('M d, Y') : null),
            ],
            'filters' => [
                SelectFilter::make('is_admin')
                    ->label('Admin')
                    ->options([
                        '1' => 'Admin',
                        '0' => 'User',
                    ]),
            ],
            'actions' => [
                Action::make('view')
                    ->label('View')
                    ->url(fn (array $record) => admin_path('users/'.$record['id'])),
                Action::make('edit')
                    ->label('Edit')
                    ->url(fn (array $record) => admin_path('users/'.$record['id'].'/edit')),
                Action::make('delete')
                    ->label('Delete')
                    ->delete(fn (array $record) => admin_path('users/'.$record['id'])),
            ],
            'bulk_actions' => [
                BulkAction::make('delete')
                    ->label('Delete selected')
                    ->delete(fn (array $ids) => User::whereIn('id', $ids)->delete()),
            ],
            'settings' => [
                'record_selection' => true,
                'selection_column' => 'id',
                'bulk_url' => admin_path('users/bulk'),
            ],
        ];
    }
}
