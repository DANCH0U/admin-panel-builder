namespace App\Http\Controllers\{{ controllerNamespace }};

use App\AdminPanel\Engine\DataGridEngine;
use App\AdminPanel\Notifications\Notify;
use {{ resourceFqcn }};
{{ formImport }}{{ viewImport }}use {{ modelFqcn }};
use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use Inertia\Inertia;

class {{ class }} extends Controller
{
    public function index(Request $request, DataGridEngine $engine)
    {
        $data = $engine->handle(new {{ resourceClass }}(), $request);

        return Inertia::render('Admin/ResourceIndex', [
            'resource' => $data,
            'title' => '{{ title }}',
            'description' => null,
            'createUrl' => {{ createUrl }},
            'createLabel' => {{ createLabel }},
        ]);
    }

    public function bulk(Request $request, DataGridEngine $engine)
    {
        return $engine->runBulkAction(new {{ resourceClass }}(), $request);
    }
{{ formMethods }}{{ viewMethods }}
}
