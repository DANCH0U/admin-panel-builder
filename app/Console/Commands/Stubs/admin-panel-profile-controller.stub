<?php

namespace App\Http\Controllers\{{ panelStudly }};

use App\AdminPanel\Notifications\Notify;
use App\AdminPanel\Pages\{{ panelStudly }}\ProfilePage;
use App\Http\Controllers\Controller;
use App\Notifications\AdminNotification;
use App\Services\FileUploadService;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\Hash;
use Illuminate\Validation\Rules\Password;
use Illuminate\Validation\ValidationException;
use Inertia\Inertia;

class ProfileController extends Controller
{
    public function edit(Request $request)
    {
        $user = $request->user();
        $page = new ProfilePage(array_merge(
            $user->only(['name', 'email', 'avatar']),
            ['type' => 'edit', 'id' => $user->id],
        ));

        return Inertia::render('Admin/SchemaPage', $page->toInertia([
            'initialData' => $page->initialData(),
        ]));
    }

    public function update(Request $request, FileUploadService $uploads)
    {
        $user = $request->user();

        $validated = $request->validate([
            'name' => ['required', 'string', 'max:120'],
            'email' => ['required', 'email', 'max:255', 'unique:users,email,'.$user->id],
            'password' => ['nullable', 'confirmed', Password::defaults()],
            'avatar_file' => ['nullable', 'image', 'max:2048'],
        ]);

        $user->name = $validated['name'];
        $user->email = $validated['email'];

        if ($request->hasFile('avatar_file')) {
            $uploads->delete($user->avatar);
            $user->avatar = $uploads->upload($request->file('avatar_file'), 'avatars');
        }

        if (! empty($validated['password'])) {
            $user->password = Hash::make($validated['password']);
        }

        $user->save();

        Notify::success('Profile updated.');
        AdminNotification::send(
            $user,
            'Your profile was updated.',
            title: 'Profile',
            type: 'success',
            url: admin_path('profile'),
        );

        return back();
    }

    public function destroy(Request $request)
    {
        $request->validate([
            'password' => ['required', 'string'],
        ]);

        $user = $request->user();

        if (! Hash::check($request->input('password'), $user->password)) {
            throw ValidationException::withMessages([
                'password' => ['The password is incorrect.'],
            ]);
        }

        Auth::logout();

        $user->delete();

        $request->session()->invalidate();
        $request->session()->regenerateToken();

        return redirect()->to('/login')->with('success', 'Your account has been deleted.');
    }
}
