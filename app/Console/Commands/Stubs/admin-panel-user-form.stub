<?php

namespace App\AdminPanel\Pages\{{ panelStudly }};

use App\AdminPanel\Engine\BasePage;
use App\AdminPanel\PanelRegistry;
use App\AdminPanel\Schema\Button;
use App\AdminPanel\Schema\Card;
use App\AdminPanel\Schema\FileInput;
use App\AdminPanel\Schema\Flex;
use App\AdminPanel\Schema\Form;
use App\AdminPanel\Schema\Grid;
use App\AdminPanel\Schema\Heading;
use App\AdminPanel\Schema\Select;
use App\AdminPanel\Schema\Space;
use App\AdminPanel\Schema\Text;
use App\AdminPanel\Schema\TextInput;
use App\AdminPanel\Schema\Toggle;

class UserFormPage extends BasePage
{
    /** @var object */
    protected object $data;

    public function __construct(array|object $data = [])
    {
        $this->data = is_array($data) ? (object) $data : $data;
    }

    public function title(): ?string
    {
        if (($this->data->type ?? null) === 'create') {
            return 'Create user';
        }

        return $this->data->name ?? 'Edit user';
    }

    public function schema(): array
    {
        $isCreate = ($this->data->type ?? null) === 'create';
        $panelOptions = collect(PanelRegistry::all())
            ->mapWithKeys(fn ($panel) => [$panel->getId() => $panel->getName()])
            ->all();

        $heading = $isCreate ? 'Create user' : 'Edit user';
        $description = $isCreate
            ? 'Add a new user with name, email, password, and panel access.'
            : 'Update this user’s account details and panel access.';

        return [
            Flex::make()
                ->direction('column')
                ->align('start')
                ->gap(1)
                ->schema([
                    Heading::make($heading)->level(1),
                    Text::make($description)->variant('subdued'),
                ]),

            Space::make(6),

            Form::make()
                ->action($isCreate ? admin_path('users') : admin_path('users/'.$this->data->id))
                ->method($isCreate ? 'POST' : 'PUT')
                ->schema([
                    Card::make()
                        ->border()
                        ->label('User details')
                        ->helpText('Fields from the User model.')
                        ->schema([
                            Grid::make(2)->schema([
                                TextInput::make('name')
                                    ->label('Name')
                                    ->required(),
                                TextInput::make('email')
                                    ->label('Email')
                                    ->email()
                                    ->required(),
                                TextInput::make('password')
                                    ->label('Password')
                                    ->password()
                                    ->helpText($isCreate ? 'Required for new users.' : 'Leave blank to keep the current password.')
                                    ->required($isCreate),
                                Select::make('default_panel')
                                    ->label('Default panel')
                                    ->options($panelOptions)
                                    ->placeholder('None'),
                            ]),
                            Space::make(4),
                            FileInput::make('avatar')
                                ->label('Avatar')
                                ->image(),
                            Space::make(4),
                            Toggle::make('is_admin')
                                ->label('Admin access'),
                        ]),
                    Space::make(4),
                    Flex::make()->justify('end')->schema([
                        Button::make('Cancel')->variant('secondary')->back()->showOnBottomBar(),
                        Button::make('Save')->variant('primary')->submit()->showOnBottomBar(),
                    ]),
                ]),
        ];
    }

    public function initialData(): array
    {
        return [
            'name' => $this->data->name ?? '',
            'email' => $this->data->email ?? '',
            'password' => '',
            'avatar' => $this->data->avatar ?? '',
            'avatar_file' => null,
            'is_admin' => (bool) ($this->data->is_admin ?? false),
            'default_panel' => $this->data->default_panel ?? '',
        ];
    }
}
