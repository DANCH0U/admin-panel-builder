<?php

namespace {{ namespace }};

use App\AdminPanel\Engine\BasePage;
use App\AdminPanel\Schema\Button;
use App\AdminPanel\Schema\Card;
use App\AdminPanel\Schema\Flex;
use App\AdminPanel\Schema\Form;
use App\AdminPanel\Schema\Heading;
use App\AdminPanel\Schema\Space;
use App\AdminPanel\Schema\Text;
use App\AdminPanel\Schema\TextInput;

class {{ class }} extends BasePage
{
    /** @var object */
    protected object $data;

    public function __construct(array|object $data = [])
    {
        $this->data = is_array($data) ? (object) $data : $data;
    }

    public function title(): ?string
    {
        if (($this->data->type ?? null) === 'create') {
            return 'Create {{ titleSingular }}';
        }

        return $this->data->name ?? 'Edit {{ titleSingular }}';
    }

    public function schema(): array
    {
        $isCreate = ($this->data->type ?? null) === 'create';
        $heading = $isCreate ? 'Create {{ titleSingular }}' : 'Edit {{ titleSingular }}';
        $description = $isCreate
            ? 'Create a new {{ titleSingular }}.'
            : 'Update this {{ titleSingular }} record.';

        return [
            Flex::make()
                ->direction('column')
                ->align('start')
                ->gap(1)
                ->schema([
                    Heading::make($heading)->level(1),
                    Text::make($description)->variant('subdued'),
                ]),

            Space::make(6),

            Form::make()
                ->action($isCreate ? admin_path('{{ key }}') : admin_path('{{ key }}/'.$this->data->id))
                ->method($isCreate ? 'POST' : 'PUT')
                ->schema([
                    Card::make()
                        ->border()
                        ->label('{{ titleSingular }}')
                        ->helpText('Fill in the fields below.')
                        ->schema([
                            TextInput::make('name')
                                ->label('Name')
                                ->required(),
                        ]),
                    Space::make(4),
                    Flex::make()->justify('end')->schema([
                        Button::make('Cancel')->variant('secondary')->back()->showOnBottomBar(),
                        Button::make('Save')->submit()->showOnBottomBar(),
                    ]),
                ]),
        ];
    }

    public function initialData(): array
    {
        return [
            'name' => $this->data->name ?? '',
        ];
    }
}
