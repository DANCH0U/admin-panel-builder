<?php

namespace {{ namespace }};

use App\AdminPanel\Engine\BasePage;
use App\AdminPanel\Schema\Button;
use App\AdminPanel\Schema\Card;
use App\AdminPanel\Schema\Flex;
use App\AdminPanel\Schema\Form;
use App\AdminPanel\Schema\Heading;
use App\AdminPanel\Schema\Space;
use App\AdminPanel\Schema\Text;
use App\AdminPanel\Schema\TextInput;
use {{ modelFqcn }};

class {{ class }} extends BasePage
{
    public function __construct(
        protected string $action,
        protected string $method = 'POST',
        protected ?string $pageTitle = null,
        protected ?{{ modelClass }} ${{ modelVar }} = null,
    ) {}

    public function title(): ?string
    {
        return $this->pageTitle ?? ($this->{{ modelVar }} ? 'Edit {{ titleSingular }}' : 'Create {{ titleSingular }}');
    }

    public function authorize(): bool
    {
        return true;
    }

    public function schema(): array
    {
        $heading = $this->{{ modelVar }} ? 'Edit {{ titleSingular }}' : 'Create {{ titleSingular }}';
        $description = $this->{{ modelVar }}
            ? 'Update this {{ titleSingular }} record.'
            : 'Create a new {{ titleSingular }}.';

        return [
            Flex::make()
                ->direction('column')
                ->align('start')
                ->gap(1)
                ->schema([
                    Heading::make($heading)->level(1),
                    Text::make($description)->variant('subdued'),
                ]),

            Space::make(6),

            Form::make()
                ->action($this->action)
                ->method($this->method)
                ->schema([
                    Card::make()
                        ->border()
                        ->label('{{ titleSingular }}')
                        ->helpText('Fill in the fields below.')
                        ->schema([
                            TextInput::make('name')
                                ->label('Name')
                                ->required(),
                        ]),
                    Space::make(4),
                    Flex::make()->justify('end')->sticky()->schema([
                        Button::make('Cancel')->variant('secondary')->back(),
                        Button::make('Save')->submit(),
                    ]),
                ]),
        ];
    }

    public function initialData(): array
    {
        return [
            'name' => $this->{{ modelVar }}?->name ?? '',
        ];
    }
}
