<?php

namespace App\AdminPanel\Panels;

use App\AdminPanel\Menu\MenuItem;
use App\AdminPanel\Menu\PanelMenu;
use App\AdminPanel\Panel;

class {{ class }} extends Panel
{
    public function __construct()
    {
        parent::__construct('{{ id }}');

        $this
            ->prefix('{{ prefix }}')
            // Add 'admin' middleware for is_admin-only access: ['auth', 'admin', 'panel:{{ id }}']
            ->middleware(['auth', 'panel:{{ id }}'])
            ->name('{{ title }}')
            ->logo(null)
            ->navbarTitle('{{ title }}')
            ->showThemeToggle(true);
            // ->hidden(); // hide from user-menu switcher
    }

    public function menu(): array
    {
        return PanelMenu::make()
            ->default()
            ->section('management', [
                MenuItem::link('users', admin_path('users'))
                    ->icon('heroicons:users')
                    ->title('Users'),
            ])
            ->build();
    }
}
