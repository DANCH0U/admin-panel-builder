<?php

use App\Http\Controllers\{{ panelStudly }}\DashboardController;
use App\Http\Controllers\{{ panelStudly }}\ProfileController;
use App\Http\Controllers\{{ panelStudly }}\UserController;
use Illuminate\Support\Facades\Route;

/*
|--------------------------------------------------------------------------
| {{ title }} panel (`{{ panel }}`) routes
