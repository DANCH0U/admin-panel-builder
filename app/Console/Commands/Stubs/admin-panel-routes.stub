Route::delete('/profile', [ProfileController::class, 'destroy'])->name('{{ panel }}.profile.destroy');

Route::post('/users/bulk', [UserController::class, 'bulk'])->name('{{ panel }}.users.bulk');
Route::resource('users', UserController::class)->names('{{ panel }}.users');
