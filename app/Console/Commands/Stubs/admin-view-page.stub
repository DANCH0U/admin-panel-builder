<?php

namespace {{ namespace }};

use App\AdminPanel\Engine\BasePage;
use App\AdminPanel\Schema\Button;
use App\AdminPanel\Schema\Card;
use App\AdminPanel\Schema\Flex;
use App\AdminPanel\Schema\Heading;
use App\AdminPanel\Schema\KeyValue;
use {{ modelFqcn }};

class {{ class }} extends BasePage
{
    public function __construct(protected {{ modelClass }} ${{ modelVar }}) {}

    public function title(): ?string
    {
        return $this->{{ modelVar }}->name ?? '{{ titleSingular }}';
    }

    public function authorize(): bool
    {
        return true;
    }

    public function schema(): array
    {
        $record = $this->{{ modelVar }};

        return [
            Flex::make()->justify('between')->schema([
                Heading::make($record->name ?? '{{ titleSingular }}')->level(2),
                Flex::make()->schema([
                    Button::make('Edit')
                        ->variant('outline')
                        ->url(admin_path('{{ key }}/'.$record->getKey().'/edit')),
                    Button::make('Back')
                        ->variant('secondary')
                        ->url(admin_path('{{ key }}')),
                ]),
            ]),
            Card::make()->border()->label('Details')->schema([
                KeyValue::make()->entries([
                    'ID' => $record->getKey(),
                    'Name' => $record->name ?? '—',
                    'Created' => $record->created_at?->format('M d, Y H:i') ?? '—',
                ]),
            ]),
        ];
    }
}
