<?php

namespace App\AdminPanel\Pages\{{ panelStudly }};

use App\AdminPanel\Engine\BasePage;
use App\AdminPanel\Schema\Button;
use App\AdminPanel\Schema\Card;
use App\AdminPanel\Schema\Flex;
use App\AdminPanel\Schema\Form;
use App\AdminPanel\Schema\Grid;
use App\AdminPanel\Schema\Heading;
use App\AdminPanel\Schema\Space;
use App\AdminPanel\Schema\Text;
use App\AdminPanel\Schema\TextInput;
use App\Models\User;

class ProfilePage extends BasePage
{
    public function __construct(protected User $user) {}

    public function title(): ?string
    {
        return 'Profile';
    }

    public function authorize(): bool
    {
        return true;
    }

    public function schema(): array
    {
        return [
            Flex::make()
                ->direction('column')
                ->align('start')
                ->gap(1)
                ->schema([
                    Heading::make('Profile')->level(1),
                    Text::make('Update your account details or permanently delete your account.')
                        ->variant('subdued'),
                ]),

            Space::make(6),

            Form::make()
                ->action(admin_path('profile'))
                ->method('POST')
                ->schema([
                    Card::make()
                        ->border()
                        ->label('Account')
                        ->helpText('Your name, email, and optional password change.')
                        ->schema([
                            Grid::make(2)->schema([
                                TextInput::make('name')
                                    ->label('Name')
                                    ->required(),
                                TextInput::make('email')
                                    ->label('Email')
                                    ->email()
                                    ->required(),
                            ]),
                            Space::make(4),
                            Text::make('Leave password blank to keep your current password.')
                                ->variant('caption'),
                            Space::make(2),
                            Grid::make(2)->schema([
                                TextInput::make('password')
                                    ->label('New password')
                                    ->password()
                                    ->placeholder('••••••••'),
                                TextInput::make('password_confirmation')
                                    ->label('Confirm password')
                                    ->password()
                                    ->placeholder('••••••••'),
                            ]),
                        ]),
                    Space::make(4),
                    Flex::make()->justify('end')->schema([
                        Button::make('Save profile')->submit()->showOnBottomBar(),
                    ]),
                ]),

            Space::make(8),

            Form::make()
                ->action(admin_path('profile'))
                ->method('DELETE')
                ->schema([
                    Card::make()
                        ->border()
                        ->label('Delete account')
                        ->helpText('Permanently remove your account and all associated data. This cannot be undone.')
                        ->schema([
                            Text::make('Enter your current password to confirm account deletion.')
                                ->variant('subdued'),
                            Space::make(4),
                            TextInput::make('password')
                                ->label('Current password')
                                ->password()
                                ->required()
                                ->placeholder('••••••••'),
                        ]),
                    Space::make(4),
                    Flex::make()->justify('end')->schema([
                        Button::make('Delete account')
                            ->variant('destructive')
                            ->submit()
                            ->showOnBottomBar(),
                    ]),
                ]),
        ];
    }

    public function initialData(): array
    {
        return [
            'name' => $this->user->name,
            'email' => $this->user->email,
            'password' => '',
            'password_confirmation' => '',
        ];
    }
}
